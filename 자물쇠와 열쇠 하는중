        for x in range(n * 2):
            for y in range(n * 2):
                
                # 1. 자물쇠에 열쇠 넣기
                for i in range(m):
                    for j in range(m):
                        new_lock[x + i][y + j] += key[i][j]
                        
                # 2. 자물쇠가 정확히 다 들어맞는지 확인
                if check(new_lock) == True:
                    return True
                
